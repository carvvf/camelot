PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

#### USER DEFINED ENVIRONMENT ################################

### Remove background images and watermarks for improved detection of table bounding boxes
### Default value is True
#REMOVE_BACKGROUND_ARTIFACTS=False

### Remove native text for Lattice improved detection of table bounding boxes
### Default value is True
REMOVE_NATIVE_TEXT=False

INPUT_FILE_DIR="PDF"
OUTPUT_FILE_DIR="camelot"
BASE_DATA_DIR="$(realpath "${PROJECT_ROOT}/../../data/${INPUT_FILE_DIR}")/"
#BASE_DATA_DIR="${BASE_DATA_DIR%/}/"

#  [my upper dir]/
#   ├─ data/
#   │   └─ PDF/          <-- input pdf dir
#   │      └─ camelot/   <-- out dir
#   └─ [my source dir]/
#       └─ camelot/      <-- project root dir

##############################################################

VENV_DIR="$PROJECT_ROOT/.venv"

OUT_DIR="${BASE_DATA_DIR}${OUTPUT_FILE_DIR}/"
#OUT_DIR="${OUT_DIR%/}/"
